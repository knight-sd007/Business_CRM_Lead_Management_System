# Business CRM Lead Management API Configuration
# Copy this file to .env and configure local development values.
# NEVER commit the actual .env file or real production credentials to Git.

# API Settings
APP_NAME="Business CRM Lead Management API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database Configuration
DATABASE_URL=sqlite:////app/data/crm_lead_management.db

# Security & Session Configuration
# In production, SECRET_KEY MUST be a strong random secret with at least 32 characters.
SECRET_KEY=change_this_to_a_secure_random_32_char_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_NAME=crm_session
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true

# Optional Initial Admin Bootstrap (Used only for one-time initialization on first startup)
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.example.com
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change_this_to_a_secure_password
# BOOTSTRAP_ADMIN_FULL_NAME="System Administrator"
